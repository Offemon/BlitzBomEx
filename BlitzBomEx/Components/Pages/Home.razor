            throw;
        }
    }

    public void CheckAllData()
    {
        CheckRecipesData();
        CheckTaggingData();
        CheckSalesData();
    }

    public void DisableAllBtn()
    {
        _isEnabled = false;
        _canPurge = false;
        _canExplode = false;
    }

    public void EnableAllBtn()
    {
        _isEnabled = true;
        _canPurge = HasPurgables();
        _canExplode = true;
    }

    public string FormatDateTime(DateTime dateTime)
    {
        return dateTime > DateTime.MinValue ? dateTime.ToString("g") : "N/A";
    }

    public string FormatDateOnly(DateOnly dateOnly)
    {
        return dateOnly > DateOnly.MinValue ? dateOnly.ToString("dd-MM-yyyy") : "N/A";
    }

    public bool HasPurgables()
    {
        if (LiteDbService.GetRecipes().Any() || LiteDbService.GetPosBomTaggings().Any() || LiteDbService.GetSalesData().Any() || LiteDbService.GetMetaData() is not null)
        {
            return true;
        }
        return false;
    }

    public bool AreDatasetsComplete()
    {
        // Neet to check DAG upon startup
        return LiteDbService.GetRecipes().Any() || LiteDbService.GetPosBomTaggings().Any() || LiteDbService.GetSalesData().Any();
    }
    
    public async Task PurgeAllData()
    {
        LogToConsole("Purging started...");
        
        LogToConsole("Purging all recipes...");
        LiteDbService.PurgeRecipes();
        _hasRecipesData = false;
        LogToConsole("Purging of all recipes completed.");
        
        LogToConsole("Purging all POS tagging...");
        LiteDbService.PurgePosBomTaggings();
        _hasTagging = false;
        LogToConsole("Purging of all POS tagging completed.");
        
        LogToConsole("Purging all Sales data...");
        LiteDbService.PurgeSalesData();
        _hasSalesData = false;
        LogToConsole("Purging of all sales data completed.");
        
        LogToConsole("Puring Metadata...");
        LiteDbService.PurgeMetaData();
        _hasMetaData = false;
        LogToConsole("Puring MetaData completed.");
        
        LogToConsole("Purged the entire database.");
        
        LogToConsole("Clearing memory datastructures...");
        DagTree.Clear();
        LogToConsole("Memory datastructures cleared!");
        _canExplode = false;
        LogToConsole("Reinitializing Metadata...");
        await InitializeMetaDataAsync();
        CheckAllData();
    }
    
