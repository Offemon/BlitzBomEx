    public void PurgeAllData()
    {
        LogToConsole("Purging started...");
        
        LogToConsole("Purging all recipes...");
        LiteDbService.PurgeRecipes();
        _hasRecipesData = false;
        LogToConsole("Purging of all recipes completed.");
        
        LogToConsole("Purging all POS tagging...");
        LiteDbService.PurgePosBomTaggings();
        _hasTagging = false;
        LogToConsole("Purging of all POS tagging completed.");
        
        LogToConsole("Purging all Sales data...");
        LiteDbService.PurgeSalesData();
        _hasSalesData = false;
        LogToConsole("Purging of all sales data completed.");
        
        LogToConsole("Puring Metadata...");
        LiteDbService.PurgeMetaData();
        _hasMetaData = false;
        LogToConsole("Puring MetaData completed.");
        
        LogToConsole("Purged the entire database.");
        
        LogToConsole("Clearing memory datastructures...");
        DagTree.Clear();
        LogToConsole("Memory datastructures cleared!");
        _canExplode = false;
        LogToConsole("Reinitializing Metadata...");
        InitializeMetaData();
        CheckAllData();
    }
