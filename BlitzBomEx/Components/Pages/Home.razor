    public async Task InitializeMetaDataAsync()
    {
        try
        {
            DataStatus = await Task.Run(() =>
            {
                var meta = LiteDbService.GetMetaData();
                LogToConsole("Checking Metadata...");
                if (meta is null)
                {
                    LogToConsole("Metadata not found");
                    LogToConsole("Initializing Metadata...");
                    meta = new MetaDataModel();
                    LiteDbService.CreateMetaData(meta);
                    LogToConsole("Metadata created.");
                }
                LogToConsole("Loading Metadata...");
                return meta;
            });
            _hasMetaData = true;
            BomDate = FormatDateTime(DataStatus.BomUpdateDate);
            TaggingDate = FormatDateTime(DataStatus.TaggingUpdateDate);
            SalesUpdateDate = FormatDateTime(DataStatus.SalesUpdateDate);
            SalesStartDate = FormatDateOnly(DataStatus.SalesStartDate);
            SalesEndDate = FormatDateOnly(DataStatus.SalesEndDate);
            LogToConsole("Metadata loaded!");
        }
        catch (Exception ex)
        {
            LogToConsole($"Failed to access database: {ex.Message}");
            throw;
        }
    }
