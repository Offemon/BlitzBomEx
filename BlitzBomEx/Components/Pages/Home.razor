    public void SaveSalesData(Stream excelStream)
    {
        try
        {
            LogToConsole("Purging existing Sales data...");
            LiteDbService.PurgeSalesData();
            LogToConsole("Purging existing Sales data completed.");
            LogToConsole("Preparing xlsx data for database...");
            using var workbook = new XLWorkbook(excelStream);
            var worksheet = workbook.Worksheets.First();
            var salesEntryList = new List<SalesDataModel>();
            var xlsxContent = worksheet.RowsUsed().Skip(2).ToList();
            int dataRows = xlsxContent.Count;
            DateTime? sdt = null;
            DateTime? edt = null;
            LogToConsole($"Detected {dataRows} sales entries.");
            LogToConsole("Mapping data to data model.");
            try
            {
                for (int r = 0; r < dataRows; r++)
                {
                    var extractedDate = DateTime.FromOADate(xlsxContent[r].Cell(5).GetValue<double>());
                    if (sdt is null)
                    {
                        sdt = extractedDate;
                    }
                    else if (sdt > extractedDate)
                    {
                        sdt = extractedDate;
                    }
                    if (edt is null)
                    {
                        edt = extractedDate;
                    }
                    else if (edt < extractedDate)
                    {
                        edt = extractedDate;
                    }
                //Insert validation logic here
                    var data = new SalesDataModel()
                    {
                        StoreCode = xlsxContent[r].Cell(1).GetString(),
                        StoreName = xlsxContent[r].Cell(2).GetString(),
                        BrandCode = xlsxContent[r].Cell(3).GetString(),
                        BrandPosCode = xlsxContent[r].Cell(4).GetString(),
                        SalesDateTime = extractedDate,
                        SalesPosCode = xlsxContent[r].Cell(6).GetString(),
                        SalesItemName = xlsxContent[r].Cell(7).GetString(),
                        SalesQuantity = xlsxContent[r].Cell(8).GetValue<int>(),
                        SalesAmount = xlsxContent[r].Cell(9).GetValue<decimal>()
                    };
                    salesEntryList.Add(data);
                }
            }
            catch (Exception ex)
            {
               LogToConsole($"Error: {ex.Message}"); 
            }
            LogToConsole($"{salesEntryList.Count} sales data detected.");
            LogToConsole("Saving sales data to database...");
            LiteDbService.AddSalesData(salesEntryList);
            LogToConsole("Data successfully saved");
            try
            {
                LogToConsole("Generating sales entities");
                SalesEntities = GenerateSalesGroup(salesEntryList);
                LogToConsole($"Success: Generated {SalesEntities.Count} Sales Entities");
            }
            catch (Exception ex)
            {
                LogToConsole($"Error: {ex.Message}");
                throw;
            }
            SalesStartDate = FormatDateTime(sdt,false);
            SalesEndDate = FormatDateTime(edt,false);
            CheckSalesData();
            CheckExplodable();
            _canPurge = HasPurgables();
            try
            {
                DataStatus.SalesUpdateDate = DateTime.Now;
                DataStatus.SalesStartDate = sdt;
                DataStatus.SalesEndDate = edt;
                LiteDbService.UpdateMetaData(DataStatus);
            }
            catch (Exception ex)
            {
                LogToConsole($"Error: {ex.Message}");
                throw;
            }
        }
        catch (Exception ex)
        {
            LogToConsole($"Error: {ex.Message}");
            throw;
        }
    }
    
    public void InitializeMetaData()
    {
        try
        {
            LogToConsole("Checking Metadata...");
            DataStatus = LiteDbService.GetMetaData();
            if (DataStatus is null)
            {
                    LogToConsole("Metadata not found");
                    LogToConsole("Initializing Metadata...");
                    DataStatus = new MetaDataModel();
                    LiteDbService.UpdateMetaData(DataStatus);
                    LogToConsole("Metadata created.");
            }
            _hasMetaData = true;
            BomDate = FormatDateTime(DataStatus.BomUpdateDate);
            TaggingDate = FormatDateTime(DataStatus.TaggingUpdateDate);
            SalesUpdateDate = FormatDateTime(DataStatus.SalesUpdateDate);
            SalesStartDate = FormatDateTime(DataStatus.SalesStartDate,false);
            SalesEndDate = FormatDateTime(DataStatus.SalesEndDate,false);
            LogToConsole("Metadata loaded!");
        }
        catch (Exception ex)
        {
            LogToConsole($"Metadata initialization failed: {ex.Message}");
            throw;
        }
    }
    
    public async Task Explode()
    {
        var saleEntityListSS = SalesEntities.ToList();
        var tagListSS = Taggings.ToList();
        var recipeNodeSS = RecipeNodes.ToList();
        _isExploding = true;
        LogToConsole("Exploding...");
        LogToConsole($"{Recipes.Count}");
        List<ExplosionResultModel> ExplosionResultEntities = new List<ExplosionResultModel>();
        await Task.Run(() =>
        {
            // LogToConsole($"Tags count: {tagListSS.Count}");
            // LogToConsole($"Sales count: {saleEntityListSS.Count}");
            // LogToConsole($"Recipe count: {recipeNodeSS.Count}");
            int salesEntityCount = saleEntityListSS.Count;
            for (int e = 0; e < salesEntityCount; e++)
            {

                var salesentity = saleEntityListSS[e];
                // LogToConsole($"Entry Number: {e+1}");
                string? MRepBlitzID = tagListSS.Find(t => t.BrandPosCode == salesentity.BrandPosCode)?.BlitzId;
                if (string.IsNullOrEmpty(MRepBlitzID))
                {
                    LogToConsole($"{salesentity.PosItemDescription} - {salesentity.BrandPosCode} has no bom.");
                    continue;
                }
                RecipeNodeModel Recipe = recipeNodeSS.Find(r => r.BlitzId == MRepBlitzID);
                if (Recipe is null)
                {
                    LogToConsole($"{MRepBlitzID} - {salesentity.PosItemDescription} is a retail item");
                    continue;
                }
                // LogToConsole($"Blitz ID: {Recipe.BlitzId}");
                List<ComponentModel> extractedComponents = new List<ComponentModel>();
                try
                {
                    // LogToConsole($"Extracting: [{salesentity.SalesQty}] {Recipe.BrandRecipeName}");
                    extractedComponents = ExtractRawMats(recipeNodeSS,Recipe, salesentity.SalesQty,Recipe.BrandRecipeName);
                }
                catch (Exception ex)
                {
                    _isExploding = false;
                    LogToConsole($"Error: {ex.Message}");
                    throw;
                }
                foreach (var comp in extractedComponents)
                {
                    try
                    {
                        var expRes = new ExplosionResultModel()
                        {
                            BrandCode = salesentity.BrandCode,
                            StoreCode = salesentity.StoreCode,
                            StoreName = salesentity.StoreName,
                            PosSalesCode = salesentity.PosCode,
                            PosSalesName = salesentity.PosItemDescription,
                            SalesQuantity = salesentity.SalesQty,
                            SalesAmount = salesentity.SalesAmount,
                            BrandRecipeName = comp.BrandRecipeName,
                            ComponentItemCode = comp.ComponentItemCode,
                            ComponentGenericDesc = comp.ComponentGenericDesc,
                            ComponentItemDesc = comp.ComponentName,
                            ComponentContentQty = comp.ContentQty,
                            ComponentWholeUom = comp.WholeUom,
                            ComponentWholeCost = comp.WholeCost,
                            ComponentUnitQty = comp.UnitQty,
                            ComponentUnitUom = comp.UnitUom,
                            ComponentUnitCost = comp.CostPerUnit,
                            ComponentTotalUnitQty = comp.TotalUnitQty,
                            ComponentTotalUnitCost = comp.TotalUnitQty * comp.CostPerUnit,
                            TotalWholeUomConsumed = comp.TotalUnitQty / comp.ContentQty,
                            TotalWholeCost = (comp.TotalUnitQty / comp.ContentQty) * comp.WholeCost,
                        };
                        ExplosionResultEntities.Add(expRes);
                    }
                    catch(Exception ex)
                    {
                        LogToConsole($"Error: {ex.Message}");
                    }
                }
            }
        });
        _isExploding = false;
        LogToConsole("Explosion completed");
        LogToConsole("Exporting data...");
        try
        {
            ExportExplosionResults(ExplosionResultEntities);
            LogToConsole("Data Exported!");
        }
        catch (Exception ex)
        {
            LogToConsole($"Failed to Export: {ex.Message}");
            throw;
        }
    }
    
    public List<ComponentModel> ExtractRawMats(List<RecipeNodeModel> recipeListSS,RecipeNodeModel asmComp, decimal qty, string recipeName)
    {
        List<ComponentModel> components = new List<ComponentModel>();
        foreach (var component in asmComp.Components)
        {
            if (component.ContentQty == 0)
            {
                continue;
            }
            var Recipe = recipeListSS.Find(rn => rn.BlitzId == component.ComponentBlitzId);
            if (Recipe is not null && (component.Classification == "SUB RECIPE" || component.Classification == "FINISHED GOODS"))
            {
                try
                {
                    decimal componentUsageQty = (component.UnitQty * qty) / component.ContentQty;
                    components.AddRange(ExtractRawMats(recipeListSS,Recipe, componentUsageQty,recipeName));
                }
                catch (Exception ex)
                {
                    LogToConsole($"Error: {ex.Message}");
                    System.Diagnostics.Debug.WriteLine($"Error: {ex.Message}");
            
                    throw;
                }
            }
            else
            {
                
                var newComp = new ComponentModel
                {
                    BlitzId = component.BlitzId,
                    BrandRecipeName = recipeName,
                    ComponentGenericDesc = component.ComponentGenericDesc,
                    ComponentItemCode = component.ComponentItemCode,
                    ComponentName = component.ComponentName,
                    ComponentBlitzId = component.ComponentBlitzId,
                    Classification = component.Classification,
                    ContentQty = component.ContentQty,
                    WholeCost = component.WholeCost,
                    WholeUom = component.WholeUom,
                    UnitQty = component.UnitQty,
                    UnitUom = component.UnitUom,
                    CostPerUnit = component.CostPerUnit,
                    TotalUnitQty = component.UnitQty * qty,
                    BrandCode = component.BrandCode,
                };
                components.Add(newComp);
            }
        }

        return components
        .GroupBy(excom => new
        {
            excom.ComponentBlitzId
        }).Select(com => new ComponentModel
        {
            BlitzId = com.First().BlitzId,
            BrandRecipeName = com.First().BrandRecipeName,
            ComponentGenericDesc = com.First().ComponentGenericDesc,
            ComponentItemCode = com.First().ComponentItemCode,
            ComponentName = com.First().ComponentName,
            ComponentBlitzId = com.First().ComponentBlitzId,
            Classification = com.First().Classification,
            ContentQty = com.First().ContentQty,
            WholeCost = com.First().WholeCost,
            WholeUom = com.First().WholeUom,
            UnitQty = com.First().UnitQty,
            UnitUom = com.First().UnitUom,
            CostPerUnit = com.First().CostPerUnit,
            TotalUnitQty = com.Sum(u=>u.TotalUnitQty),
            BrandCode = com.First().BrandCode
        })
        .ToList();
    }
    
    public void ExportExplosionResults(List<ExplosionResultModel> expEntities)
    {
        string desktopPath = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
        string filePath = Path.Combine(desktopPath,$"BomEx{DateTime.Now.ToString("ddMMyy_hhmmss")}.xlsx");
        using (var workbook = new XLWorkbook())
        {
            var worksheet = workbook.Worksheets.Add("Results");
            //insert headers
            worksheet.Cell(1,1).Value = "BRAND CODE";
            worksheet.Cell(1,2).Value = "STORE CODE";
            worksheet.Cell(1,3).Value = "STORE NAME";
            worksheet.Cell(1,4).Value = "POS CODE";
            worksheet.Cell(1,5).Value = "POS DESC";
            worksheet.Cell(1,6).Value = "SALES QTY";
            worksheet.Cell(1,7).Value = "SALES AMT";
            worksheet.Cell(1,8).Value = "BRAND RECIPE NAME";
            worksheet.Cell(1,9).Value = "ITEM CODE";
            worksheet.Cell(1,10).Value = "ITEM GEN DESC";
            worksheet.Cell(1,11).Value = "ITEM DESC";
            // worksheet.Cell(1,10).Value = "CONTENT QTY";
            // worksheet.Cell(1,12).Value = "WHOLE COST";
            // worksheet.Cell(1,13).Value = "UNIT QTY";
            worksheet.Cell(1,12).Value = "TOTAL UNIT QTY";
            worksheet.Cell(1,13).Value = "UNIT UOM";
            worksheet.Cell(1,14).Value = "UNIT COST";
            worksheet.Cell(1,15).Value = "TOTAL UNIT COST";
            worksheet.Cell(1,16).Value = "WHOLE QTY";
            worksheet.Cell(1,17).Value = "WHOLE UOM";
            // worksheet.Cell(1,19).Value = "TOTAL COST";
            
            // Inser Explosion Data
            for (int i = 0; i < expEntities.Count; i++)
            {
                worksheet.Cell(i + 2, 1).Value = expEntities[i].BrandCode;
                worksheet.Cell(i + 2, 2).Value = expEntities[i].StoreCode;
                worksheet.Cell(i + 2, 3).Value = expEntities[i].StoreName;
                worksheet.Cell(i + 2, 4).Value = expEntities[i].PosSalesCode;
                worksheet.Cell(i + 2, 5).Value = expEntities[i].PosSalesName;
                worksheet.Cell(i + 2, 6).Value = expEntities[i].SalesQuantity;
                worksheet.Cell(i + 2, 7).Value = expEntities[i].SalesAmount;
                worksheet.Cell(i + 2, 8).Value = expEntities[i].BrandRecipeName;
                worksheet.Cell(i + 2, 9).Value = expEntities[i].ComponentItemCode;
                worksheet.Cell(i + 2, 10).Value = expEntities[i].ComponentGenericDesc;
                worksheet.Cell(i + 2, 11).Value = expEntities[i].ComponentItemDesc;
                // worksheet.Cell(i + 2, 10).Value = expEntities[i].ComponentContentQty;
                // worksheet.Cell(i + 2, 12).Value = expEntities[i].ComponentWholeCost;
                // worksheet.Cell(i + 2, 13).Value = expEntities[i].ComponentUnitQty;
                worksheet.Cell(i + 2, 12).Value = expEntities[i].ComponentTotalUnitQty;
                worksheet.Cell(i + 2, 13).Value = expEntities[i].ComponentUnitUom;
                worksheet.Cell(i + 2, 14).Value = expEntities[i].ComponentUnitCost;
                worksheet.Cell(i + 2, 15).Value = expEntities[i].ComponentTotalUnitCost;
                worksheet.Cell(i + 2, 16).Value = expEntities[i].TotalWholeUomConsumed;
                worksheet.Cell(i + 2, 17).Value = expEntities[i].ComponentWholeUom;
                // worksheet.Cell(i + 2, 19).Value = expEntities[i].TotalWholeCost;
            }

            worksheet.Row(1).Style.Font.Bold = true;
            worksheet.Columns().AdjustToContents();
            worksheet.SheetView.FreezeRows(1);
            workbook.SaveAs(filePath);
        }
    }
    
    public void LogToConsole(string logMessage)
    {
        LogText += $"\n[{DateTime.Now:T}]: {logMessage}" ;
    }

    public void CheckRecipesData()
    {
        LogToConsole("Checking recipes in database...");
        try
        {
            var recipes = LiteDbService.GetRecipes();
            if (recipes.Any())
            {
                LogToConsole("Recipes found in database.");
                LogToConsole("Generating recipe nodes...");
                Recipes = recipes;
                // DagTree = GenerateDag(recipes);
                RecipeNodes = GenerateRecipeNodes(recipes);
                LogToConsole($"{RecipeNodes.Count} recipe nodes generated.");
                _hasRecipesData = true;
                RecipeUploadBtnIcon = Icons.Material.Filled.Refresh;
                RecipeUploadBtnColor = Color.Success;
                // Generate DAG from stored Recipe data.
            }
            else
            {
                LogToConsole("Recipes not found in database.");
                _hasRecipesData = false;
                RecipeUploadBtnIcon = Icons.Material.Filled.Upload;
                RecipeUploadBtnColor = Color.Secondary;
            }
        }
        catch (Exception ex)
        {
            LogToConsole("Database not found!");
            throw;
        }
    }
    
    public void CheckTaggingData()
    {
        LogToConsole("Checking tagging data in database...");
        try
        {
            var tagging = LiteDbService.GetPosBomTaggings();
            if (tagging.Any())
            {
                LogToConsole($"{tagging.Count} tagging data found in database.");
                Taggings = tagging;
                LogToConsole("Tagging data loaded to memory.");
                _hasTagging = true;
                TaggingUploadBtnIcon = Icons.Material.Filled.Refresh;
                TaggingUploadBtnColor = Color.Success;
            }
            else
            {
                LogToConsole("Tagging not found in database.");
                _hasTagging = false;
                TaggingUploadBtnIcon = Icons.Material.Filled.Upload;
                TaggingUploadBtnColor = Color.Secondary;
            }
        }
        catch (Exception ex)
        {
            LogToConsole("Database not found!");
            throw;
        }
    }
    
    public void CheckSalesData()
    {
        LogToConsole("Checking sales data in database...");
        try
        {
            var salesEntries = LiteDbService.GetSalesData();
            if (salesEntries.Any())
            {
                LogToConsole($"{salesEntries.Count} sales data found in database.");
                Sales = salesEntries;
                try
                {
                    LogToConsole("Generating sales entities");
                    SalesEntities = GenerateSalesGroup(Sales);
                    LogToConsole($"Success: Generated {SalesEntities.Count} Sales Entities");
                }
                catch (Exception ex)
                {
                    LogToConsole($"Error: {ex.Message}");
                    throw;
                }
                _hasSalesData = true;
                SalesDataUploadBtnIcon = Icons.Material.Filled.Refresh;
                SalesDataUploadBtnColor = Color.Success;
            }
            else
            {
                LogToConsole("Sales data not found in database.");
                _hasSalesData = false;
                SalesDataUploadBtnIcon = Icons.Material.Filled.Upload;
                SalesDataUploadBtnColor = Color.Secondary;
            }
        }
        catch (Exception ex)
        {
            LogToConsole("Database not found!");
            throw;
        }
    }

    public void CheckAllData()
    {
        CheckRecipesData();
        CheckTaggingData();
        CheckSalesData();
        if (_hasRecipesData && _hasTagging && _hasSalesData)
        {
            LogToConsole("All datasets are loaded. Blitz is ready to calculate.");
            _canExplode = true;
        }
        else
        {
            LogToConsole("Missing datasets. Blitz cannot perform calculation.");
            _canExplode = false;
        }
    }

