    public List<RecipeNodeModel> GenerateRecipeNodes(List<RecipeModel> recipes)
    {
        var nodes = recipes.GroupBy(r => new { r.BlitzId })
            .Select(g => new RecipeNodeModel
            {
                BlitzId = g.Key.BlitzId,
                BrandRecipeName = g.First().BrandRecipeName,
                GeneralClassification = g.First().GeneralClassification,
                Components = g.GroupBy(r => new{r.BlitzId, r.ComponentBlitzId, r.ComponentName})
                    .Select(cg => new ComponentModel
                    {
                        BlitzId = cg.Key.BlitzId,
                        BrandRecipeName = cg.First().BrandRecipeName,
                        ComponentGenericDesc = cg.First().GenericDescription,
                        ComponentName = cg.Key.ComponentName,
                        ComponentBlitzId = cg.Key.ComponentBlitzId,
                        ComponentItemCode = cg.First().ComponentItemCode,
                        Classification = cg.First().Classification,
                        ContentQty = cg.First().ContentQty,
                        WholeCost = cg.First().WholeCost,
                        WholeUom = cg.First().WholeUom,
                        UnitQty = cg.Sum(x=>x.UnitQty),
                        UnitUom = cg.First().UnitUom,
                        CostPerUnit = cg.First().CostPerUnit,
                        TotalUnitQty = 0m,
                        BrandCode = cg.First().BrandCode
                    }).ToList()
            }).ToList();
        return nodes;
    }

    public List<SalesGroupModel> GenerateSalesGroup(List<SalesDataModel> salesData)
    {
        var SalesGroup = salesData.GroupBy(s => new
            {
                s.BrandCode,
                s.StoreCode,
                s.StoreName,
                s.SalesPosCode,
                s.SalesItemName,
            })
            .Select(sg => new SalesGroupModel
            {
                BrandCode = sg.First().BrandCode,
                StoreCode = sg.First().StoreCode,
                StoreName = sg.First().StoreName,
                BrandPosCode = sg.First().BrandPosCode,
                PosCode = sg.First().SalesPosCode,
                PosItemDescription = sg.First().SalesItemName,
                SalesQty = sg.Sum(sq => sq.SalesQuantity),
                SalesAmount = sg.Sum(sq => sq.SalesAmount)
            }).ToList();
        return SalesGroup;
        
    }
    
