    public async Task UploadRecipesAsync(IBrowserFile xlsxfile)
    {
        try
        {
            var file = xlsxfile;
            LogToConsole($"Reading {file.Name}.");
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            LogToConsole($"Finished reading {file.Name}.");
            LogToConsole($"Saving contents of {file.Name}.");
            try
            {
                SaveRecipeData(memoryStream);
            }
            catch (Exception ex)
            {
                LogToConsole($"Failed to save contents of {file.Name} to the database");
                throw;
            }
        }
        catch (Exception ex)
        {
            LogToConsole("Failed to read BOM data...");
        }
    }
    public void SaveRecipeData(Stream excelStream)
    {
        try
        {   
            LogToConsole("Purging existing BOM data...");
            LiteDbService.PurgeRecipes();
            LogToConsole("Purging existing BOM data completed.");
            LogToConsole("Preparing xlsx data for database...");
            using var workbook = new XLWorkbook(excelStream);
            var worksheet = workbook.Worksheets.First();
            int totalRows = worksheet.RowsUsed().Count();
            // int dataRows = Math.Max(0, totalRows - 1);
            var recipeDataList = new List<RecipeModel>();
            var xlsxContent = worksheet.RowsUsed().Skip(1).ToList();
            int dataRows = xlsxContent.Count;
            LogToConsole($"Detected {dataRows} entries.");
            LogToConsole($"Mapping data to data model.");

            for (int r = 0; r < dataRows; r++)
            {
                string classification = xlsxContent[r].Cell(9).GetString();
                string componentName = xlsxContent[r].Cell(8).GetString();
                string brandCode = xlsxContent[r].Cell(20).GetString();
                if (classification=="SUB RECIPE" || classification == "FINISHED GOODS")
                {
                    componentName = $"{brandCode} - {componentName}";
                }
                var data = new RecipeModel()
                {
                    BrandRecipeName = xlsxContent[r].Cell(2).GetString(),
                    RecipeName = xlsxContent[r].Cell(4).GetString(),
                    ComponentName = componentName,
                    Classification = classification,
                    GeneralClassification = xlsxContent[r].Cell(17).GetString(),
                    ContentQty = xlsxContent[r].Cell(10).GetValue<decimal>(),
                    WholeCost = xlsxContent[r].Cell(10).GetValue<decimal>(),
                    WholeUom = xlsxContent[r].Cell(12).GetString(),
                    UnitQty = xlsxContent[r].Cell(13).GetValue<decimal>(),
                    UnitUom = xlsxContent[r].Cell(14).GetString(),
                    CostPerUnit = xlsxContent[r].Cell(15).GetValue<decimal>(),
                    BrandCode = brandCode
                };
                recipeDataList.Add(data);
            }
            LogToConsole("Data mapping completed.");
            // start of DAG creation
            LogToConsole("Starting DAG Creation...");
            var dag = recipeDataList
                .GroupBy(r => r.BrandRecipeName)
                .ToDictionary(
                    g => g.Key,
                    g=>g
                        .GroupBy(r=>r.ComponentName)
                        .Select(grp =>
                        {
                            var first = grp.First();
                            return new ComponentModel
                            {
                                ComponentName = grp.Key,
                                Classification = first.Classification,
                                ContentQty = first.ContentQty,
                                WholeCost = first.WholeCost,
                                WholeUom = first.WholeUom,
                                UnitQty = grp.Sum(r => r.UnitQty),
                                UnitUom = first.UnitUom,
                                CostPerUnit = first.CostPerUnit,
                                BrandCode = first.BrandCode
                            };
                        })
                        .ToList()
                    );
            // end of DAG creation
            LogToConsole($"DAG creation completed.");
            LogToConsole($"{dag.Count} recipes detected from uploaded file.");
            LogToConsole($"Saving recipes to the database.");
            LiteDbService.AddRecipe(recipeDataList);
            _hasBomData = true;
            LogToConsole("File Successfully saved.");
            
        }
        catch (Exception ex)
        {
            LogToConsole($"Error: {ex.Message}");
        }
    }
