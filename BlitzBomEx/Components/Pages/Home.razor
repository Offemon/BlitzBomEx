    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("OnInitialized");
        await InitializeMetaDataAsync();
        await Task.Run(() =>
        {
            CheckAllData();
        });
        _canPurge = HasPurgables();
        await base.OnInitializedAsync();
