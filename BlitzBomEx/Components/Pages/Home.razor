@page "/"
@using ClosedXML.Excel
@using System.Net.NetworkInformation
@using System.Text.Json
@inject IDialogService DialogService
@inject LiteDbService LiteDbService

<MudStack>
    <MudStack Row="true" Class="align-items-baseline">
        <MudText Typo="Typo.h3">Blitz BomEx</MudText>
        <MudText Typo="Typo.caption">@($"v{AppVersion}")</MudText>
    </MudStack>
    <MudPaper Style="width: 700px;" Class="justify-center text-center">
        <MudSimpleTable Style="overflow-x: auto;" Dense="true">
            <thead>
            <tr>
                <th>
                    Dataset
                </th>
                <th>
                    Action
                </th>
                <th>
                    Status
                </th>
                <th>
                    Details
                </th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>
                    <MudText>Recipes</MudText>
                </td>
                <td>
                    <MudFileUpload
                        T="IBrowserFile"
                        FilesChanged="UploadRecipesAsync"
                        Accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="@RecipeUploadBtnColor"
                                       StartIcon="@RecipeUploadBtnIcon">
                                @(_hasRecipesData ? "Replace":"Import")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </td>
                <td style="align-content: center;">
                    @if (_isLoadingRecipes)
                    {
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
                    }
                    else
                    {
                        if (_hasRecipesData)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"/>
                        }
                    }
                </td>
                <td>
                    Updated as of: @BomDate
                </td>
            </tr>
            <tr>
                <td>
                    <MudText>Tagging</MudText>
                </td>
                <td>
                    <MudFileUpload
                        T="IBrowserFile"
                        FilesChanged="UploadTaggingAsync"
                        Accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="@TaggingUploadBtnColor"
                                       StartIcon="@TaggingUploadBtnIcon">
                                @(_hasTagging ? "Replace":"Import")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </td>
                <td>
                    @if (_isLoadingTagging)
                    {
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
                    }
                    else
                    {
                        if (_hasTagging)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"/>
                        }
                    }
                </td>
                <td>
                    Updated as of: @TaggingDate
                </td>
            </tr>
            <tr>
                <td>
                    <MudText>Sales Data</MudText>
                </td>
                <td>
                    <MudFileUpload
                        T="IBrowserFile"
                        FilesChanged="UploadSalesDataAsync"
                        Accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                                       Color="@SalesDataUploadBtnColor"
                                       StartIcon="@SalesDataUploadBtnIcon">
                                @(_hasSalesData ? "Replace":"Import")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                </td>
                <td>
                    @if (_isLoadingSalesData)
                    {
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
                    }
                    else
                    {
                        @if (_hasSalesData)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"/>
                        }
                    }
                </td>
                <td>
                    @SalesStartDate - @SalesEndDate
                </td>
            </tr>
            </tbody>
        </MudSimpleTable>
        <MudButton
            Class="mt-1 mb-1"
            Variant="Variant.Filled"
            Color="Color.Warning"
            StartIcon="@Icons.Material.Filled.AutoAwesome"
            Disabled="@(!_canExplode)"
            @onclick="Explode"
            Size="Size.Large">
            Explode
        </MudButton>
        <MudButton
            Class="mt-1 mb-1"
            Variant="Variant.Filled"
            Color="Color.Error"
            StartIcon="@Icons.Material.Filled.DeleteForever"
            Disabled="@(!_canPurge)"
            @onclick="PurgeAllData"
            Size="Size.Large">
            Purge Collections
        </MudButton>
    </MudPaper>
    @if (_isExploding)
    {
        <MudStack Class="d-flex align-center justify-center">
            <MudProgressCircular Color="Color.Primary" Style="height:200px;width:200px;" Indeterminate="true"/>
            <MudText>Calculating...</MudText>
        </MudStack>
    }
    else
    {
        <MudTextField @bind-Value="LogText"
                      Lines="10"
                      Variant="Variant.Filled"
                      Class="font-mono text-green-300 bg-gray-950"
                      FullWidth="true"
                      ReadOnly="true"/>
    }
        @* <MudTextField @bind-Value="LogText" *@
        @*               Lines="10" *@
        @*               Variant="Variant.Filled" *@
        @*               Class="font-mono text-green-300 bg-gray-950" *@
        @*               FullWidth="true" *@
        @*               ReadOnly="true"/> *@
</MudStack>


