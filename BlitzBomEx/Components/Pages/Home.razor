    public string FormatDateTime(DateTime? dateTime)
    {
        // return dateTime > DateTime.MinValue ? dateTime.ToString("g") : "N/A";
        return dateTime.HasValue ? dateTime.Value.ToString("g") : "N/A";
    }
    
    public string FormatDateTime(DateTime? dateTime, bool showTime)
    {
        // return dateTime > DateTime.MinValue ? dateTime.ToString("g") : "N/A";
        if(showTime)
            return dateTime.HasValue ? dateTime.Value.ToString("g") : "N/A";
        return dateTime.HasValue ? dateTime.Value.ToString("D") : "N/A";
    }

    public string FormatDateOnly(DateOnly? dateOnly)
    {
        // return dateOnly > DateOnly.MinValue ? dateOnly.ToString("dd-MM-yyyy") : "N/A";
        return dateOnly.HasValue ? dateOnly.Value.ToString("dd-MM-yyyy") : "N/A";
    }

    public bool HasPurgables()
    {
        try
        {
            if (LiteDbService.GetRecipes().Any() || LiteDbService.GetPosBomTaggings().Any() || LiteDbService.GetSalesData().Any() || LiteDbService.GetMetaData() is not null)
            {
                return true;
            }
            return false;
        }
        catch (Exception ex)
        {
            LogToConsole("Has Purgables set to fales. Connection to database failed.");
            return false;
        }
    }

