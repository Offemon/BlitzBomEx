            LogToConsole("Purging existing Tagging data completed.");
            LogToConsole("Preparing xlsx data for database...");
            using var workbook = new XLWorkbook(excelStream);
            var worksheet = workbook.Worksheets.First();
            int totalRows = worksheet.RowsUsed().Count();
            var salesTaggingList = new List<PosBomTaggingModel>();
            var xlsxContent = worksheet.RowsUsed().Skip(1).ToList();
            int dataRows = xlsxContent.Count;
            LogToConsole($"Detected {dataRows} entries.");
            LogToConsole($"Mapping data to data model.");
            for (int r = 0; r < dataRows; r++)
            {
                //Insert validation logic here
                var data = new PosBomTaggingModel()
                {
                    BrandInitial = xlsxContent[r].Cell(1).GetValue<string>(),
                    PosItemCode = xlsxContent[r].Cell(2).GetValue<string>(),
                    PosItemName = xlsxContent[r].Cell(3).GetValue<string>(),
                    SearchKey = xlsxContent[r].Cell(4).GetValue<string>(),
                    BomRecipeName = xlsxContent[r].Cell(5).GetValue<string>(),
                    FoodCost = xlsxContent[r].Cell(6).GetValue<decimal>(),
                    PaperCost = xlsxContent[r].Cell(7).GetValue<decimal>(),
                    MarginOfError = xlsxContent[r].Cell(8).GetValue<decimal>(),
                    CostOfGoods = xlsxContent[r].Cell(9).GetValue<decimal>(),
                    BlitzId = xlsxContent[r].Cell(10).GetValue<string>(),
                    BrandPosCode = xlsxContent[r].Cell(11).GetValue<string>()
                };
                salesTaggingList.Add(data);
            }
            LogToConsole($"{salesTaggingList.Count} tagging data detected.");
            LogToConsole("Saving tagging to database...");
